# Copy to .env (never commit .env). Every value has a working default except DATABASE_URL.

# PostgreSQL for the pilot. Leave unset to use the JSON file store (quick demos only).
DATABASE_URL=postgres://timesflex:change-me@localhost:5432/timesflex

# API
PORT=3001
# Set true when the app is served over HTTPS.
COOKIE_SECURE=false
# Extra origins allowed to call the API with cookies (comma separated). Same-origin needs none.
CORS_ORIGINS=
LOG_REQUESTS=true

# Solver
SOLVER_URL=http://127.0.0.1:8000/solve
SOLVER_TIMEOUT_MS=150000

# Local AI (Ollama by default). AI_PROVIDER=off uses the rule parser only.
AI_PROVIDER=ollama
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=qwen3:0.6b
AI_TIMEOUT_MS=120000
