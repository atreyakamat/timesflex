# Settings for `docker compose`. ./deploy.sh creates .env from this file on the first run.

# The port the app is served on, and the network address it listens on. To keep it private to
# your Tailscale network, set WEB_BIND to this machine's Tailscale address (tailscale ip -4).
WEB_PORT=8080
WEB_BIND=0.0.0.0

# ./deploy.sh replaces this with a random password. Letters and numbers only. Postgres only reads
# it when it first creates the database, so changing it later also means changing it there.
POSTGRES_PASSWORD=change-me

# Set to false to remove the one-tap "Try the live demo" button's account creation.
ALLOW_DEMO=true

# How the assistant understands loose requests the built-in rules miss:
#   ollama    = the small local model, in its own container (default)
#   off       = built-in rules only; the fastest and lightest
#   anthropic = Claude; also set ANTHROPIC_API_KEY and AI_MODEL=claude-sonnet-5-5
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:0.5b
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5

# Optional: send through WhatsApp's official API instead of tapping to send each message by hand.
# DOCKER.md explains how to get these. Never commit real values.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=timetable_update
# WHATSAPP_TEMPLATE_LANGUAGE=en
# For delivery tracking, which also needs a public HTTPS address:
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# HTTPS for hosting: `docker compose --profile https up -d` after pointing the domain at
# this server. Then also set TRUST_PROXY=2.
# DOMAIN=timetable.example.com
# TRUST_PROXY=2
