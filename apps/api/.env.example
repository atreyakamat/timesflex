# Copy this file to .env (same folder) and fill in your key. .env is never committed.

# Claude powers the assistant and "describe your department" when this is set.
ANTHROPIC_API_KEY=

# Optional: which Claude model (default claude-sonnet-5-5).
# AI_MODEL=claude-sonnet-5-5

# Optional: force a provider instead of the automatic choice (anthropic | ollama | openai | off).
# AI_PROVIDER=anthropic
