{
  "expo": {
    "name": "TimeFlex",
    "slug": "timeflex",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.timeflex.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5B5BF0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.timeflex.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "TimeFlex",
      "themeColor": "#5B5BF0"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-asset"
    ],
    "scheme": "timeflex",
    "description": "Clash-free school and college timetables with an assistant that learns how you like them.",
    "experiments": {
      "typedRoutes": false,
      "tsconfigPaths": true
    }
  }
}
