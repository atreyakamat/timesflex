{
  "name": "timesflex",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && npm --prefix apps/mobile run typecheck",
    "test": "npm test -w @timesflex/api && npm test -w @timesflex/core && npm test -w @timesflex/web && node scripts/pytest.mjs",
    "app": "npm --prefix apps/mobile run web",
    "app:android": "npm --prefix apps/mobile run android",
    "app:ios": "npm --prefix apps/mobile run ios",
    "app:build-web": "npm --prefix apps/mobile run export:web -- --output-dir dist-web",
    "app:serve": "node scripts/serve-app.mjs apps/mobile/dist-web 8081",
    "test:e2e": "node scripts/e2e.mjs",
    "test:security": "node scripts/security-check.mjs",
    "test:roles": "node scripts/e2e-roles.mjs",
    "test:docker": "docker compose -f docker-compose.test.yml up --build --abort-on-container-exit --exit-code-from tests",
    "demo": "node scripts/demo.mjs",
    "docker:up": "sh deploy.sh",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:apk": "node scripts/build-apk.mjs"
  }
}
